NODE_ENV=production
PORT=5001
FRONTEND_URL=https://ntu.im
# 這個檔案會被 git 追蹤，絕對不要在這裡填入真正的機密值。
# 部署到伺服器後，直接在伺服器上的 .env（不進 git）手動填入以下兩項，
# 每個值都用「node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"」各自產生一組。
JWT_SECRET=CHANGE_ME_GENERATE_A_NEW_RANDOM_SECRET
UPLOAD_PATH=/var/www/ntuim/uploads
DB_PATH=./database/ntuim.db

# CORS 設定
CORS_ORIGIN=https://ntu.im

# 安全設定
SESSION_SECRET=CHANGE_ME_GENERATE_A_NEW_RANDOM_SECRET
BCRYPT_ROUNDS=12

# 檔案上傳限制
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES=application/pdf
# LINE Messaging API（通知管理員有待審核的項目）
#
# 兩者皆需填寫，缺任一項整套 LINE 通知會安靜停用（不影響其他功能）。
# 真正的值填在伺服器上的 .env（gitignored），這個檔案是版控中的範本。
#
# ⚠️ LINE_CHANNEL_SECRET 就是 webhook 驗簽的金鑰，外洩等於任何人都能偽造事件，
#    把別人的 LINE 帳號綁到自己的系統帳號上。絕對不要提交真值。
#
# 取得方式：LINE Developers Console → 建立 Messaging API channel
# Webhook URL 設為 https://ntu.im/api/line/webhook，並開啟 Use webhook、
# 關閉「自動回覆訊息」（否則會蓋掉 bot 自己的回覆）
LINE_CHANNEL_ACCESS_TOKEN=CHANGE_ME_LINE_CHANNEL_ACCESS_TOKEN
LINE_CHANNEL_SECRET=CHANGE_ME_LINE_CHANNEL_SECRET
