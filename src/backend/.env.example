# 伺服器設定
NODE_ENV=development
PORT=5000

# 前端網址
FRONTEND_URL=http://localhost:3000

# JWT 設定
JWT_SECRET=your-secret-key-change-this-in-production
JWT_EXPIRE=7d

# 資料庫設定
DB_PATH=./database/ntuim.db

# 系學會費：各年級「系學會費」欄標記 O 才視為已繳費（快取 5 分鐘）。
# 新註冊、登入及已登入的 API 請求皆使用此表；既有帳號會同步更新。
FEE_SHEET_SPREADSHEET_ID=1xHGJUZsynRpxp6gGAKCZhwXGMkubDSDx5zxvpNJdYP8
FEE_SHEET_GID=0

# 檔案上傳設定
UPLOAD_MAX_SIZE=10485760
ALLOWED_FILE_TYPES=pdf,doc,docx,ppt,pptx,jpg,jpeg,png

# Rate Limiting
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX=100

# 日誌設定
LOG_LEVEL=info
LOG_FILE=./logs/app.log
# 寄信（忘記密碼的重設連結）。設定方式見 DEPLOYMENT.md 的「寄信設定」。
# 沒填時忘記密碼照樣回「已寄出」，但信不會真的寄出（開發環境會把連結印在 console）。
# ⚠️ SMTP_PASS 是應用程式密碼，只填在伺服器上的 .env，不要 commit。
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM="台大資管系學會 <imsa@ntu.im>"
